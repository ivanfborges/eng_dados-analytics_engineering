  "candidate_order": [
    "global_median",
    "room_median",
    "ridge_property",
    "ridge_geo",
    "histgb_property",
    "histgb_geo"
  ],
  "ridge": {
    "alpha": 10.0,
    "target": "log1p(price)",
    "inverse": "maximum(0, expm1(prediction))"
  },
  "histgb": {
    "loss": "absolute_error",
    "max_iter": 200,
    "max_leaf_nodes": 15,
    "learning_rate": 0.05,
    "min_samples_leaf": 20,
    "l2_regularization": 1.0,
    "early_stopping": false,
    "random_state": 42,
    "target": "price in BRL"
  },
  "numeric_property": [
    "accommodates",
    "bedrooms",
    "beds",
    "bathrooms",
    "minimum_nights"
  ],
  "categorical_property": [
    "room_type",
    "property_type"
  ],
  "geographic_extension": [
    "latitude",
    "longitude",
    "neighbourhood_cleansed"
  ],
  "preprocessing": "Semantic invalid numeric values -> missing; fold-fitted median imputation with indicators for all numeric fields, standard scaling for Ridge; categories missing token and one-hot(handle_unknown=ignore), dense for HistGB. No price trimming. IDs excluded.",
  "selection": "Lowest pooled host-CV MAE in BRL across the six candidates; ties within 1e-9 use candidate_order. Spatial results are diagnostic, not a second tuning objective. No extra search after results.",
  "validation": "After CV selection, fit chosen candidate on training only and report validation once; no re-ranking or hyperparameter changes. If results suggest redesign, document new development protocol while leaving final test unused.",
  "final": "Freeze selected configuration, trained artifact and validation report before one final-test evaluation. Do not refit on train+validation in this version.",
  "metrics": [
    "mae_brl",
    "median_absolute_error_brl",
    "rmse_brl",
    "rmsle",
    "host_weighted_mae_brl"
  ],
  "bootstrap": {
    "unit": "host",
    "replicates": 1000,
    "seed": 42,
    "interval": "percentile 2.5/97.5, pooled listing MAE; fixed predictions, no refitting"
  },
  "publication": "Aggregate results only; subgroup metrics require >=30 priced listings and >=10 hosts; individual assignments, labels and predictions stay local"
}
